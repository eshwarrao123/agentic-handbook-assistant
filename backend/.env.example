# Application Environment
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# LLM Gateway Settings (Phase 4+)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Storage and Local Data Paths (Phase 3+)
DATA_DIR=./data
CHROMA_DIR=./data/chroma
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# RAG & Handbook Ingestion (Phase 4)
HANDBOOK_URL=https://raw.githubusercontent.com/example/handbook/main/employee_handbook.pdf
HANDBOOK_FILENAME=employee_handbook.pdf
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_DISTANCE=0.45

# Booking Settings (Phase 5)
SLOTS_OFFERED=3
BOOKING_TIMEZONE=Asia/Kolkata
